# Server-local values for the ops scripts: copy to ~/chakra-ops/ops.env (mode 600) and set what the role needs.
# Every value below is a placeholder; ops/README.md lists which role reads which value.

# AWS (app-server, replica, staging)
AWS_BIN=aws                                        # AWS CLI binary, a full path if it is not on PATH
AWS_REGION=ap-south-1                              # region of the bucket and of CloudWatch
BACKUP_BUCKET=s3://example-backup-bucket           # versioned bucket for backups, config snapshots and status files

# Tunnels (ports on the app server where each reverse tunnel ends)
ROOT2_TUNNEL_PORT=2222                             # web server's tunnel (app-server, web-server)
REPLICA_TUNNEL_PORT=2223                           # jump host's tunnel to the replica (app-server, jump-host)

# app-server
CHAKRA_HOST=chakra.example.org                     # public hostname of the Chakra editor
LSYNCD_ROOT2_KEY=/home/ubuntu/.ssh/id_lsyncd_web   # key lsyncd uses to reach the web server
LSYNCD_REPLICA_KEY=/home/ubuntu/.ssh/id_lsyncd_replica  # key lsyncd uses to reach the replica

# app-server, staging
GUARD_S3_PREFIX=env                                # bucket prefix for config snapshots (staging uses staging/env)
GUARD_EXTRA_TRACKED="/etc/lsyncd/lsyncd.conf.lua"  # space-separated files the guard checks but does not lock (empty on staging)

# replica
SITE_HOST=www.example.org                          # public site the replica serves
FACSPACE_BUCKET=example-faculty-bucket             # bucket mounted read-only at /home/root2/s3bucket

# web-server
ROOT2_TUNNEL_DEST=ubuntu@203.0.113.10              # ssh destination of the app server
ROOT2_TUNNEL_KEY=/home/root2/.ssh/id_tunnel        # key for that tunnel
REPLICA_PUSH_DEST=root2@203.0.113.20               # ssh destination of the replica
REPLICA_PUSH_KEY=/home/root2/.ssh/id_replica_push  # key for the nginx push

# jump-host
APP_SERVER_SSH_DEST=chakra-app                     # ssh destination of the app server (user@host or a ~/.ssh/config alias)
REPLICA_SSH_ADDR=203.0.113.20                      # replica address as the jump host reaches it
